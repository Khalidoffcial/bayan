# Cloudinary — signed media uploads (server-side only)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bayan_space

# LibreTranslate — مزود ترجمة مفتوح المصدر (backend only)
# عنوان النسخة المستضافة ذاتيًا أو خدمة موثوقة. لا عنوان ثابت في الكود.
# بدون هذا المتغير: مزود الترجمة معطّل والسيرفر يعمل (ترجمة غير متاحة)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# نافذة منع تكرار المشاهدات (مللي ثانية) — افتراضي 24 ساعة
VIEW_WINDOW_MS=86400000

# -- Bayan Control Center (Phase 1) --
# Secret for admin JWTs (REQUIRED to enable /admin/api). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
# One-time bootstrap token for creating the first Super Admin (leave empty to disable bootstrap)
ADMIN_BOOTSTRAP_TOKEN=
# Admin access-token TTL seconds (default 7200 = 2h)
ADMIN_TTL_SECONDS=7200
# Salt for hashing IPs in audit records
ADMIN_AUDIT_SALT=

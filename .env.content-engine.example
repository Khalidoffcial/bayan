# ── Bayan Content Engine ──
# Master switch (present but inert when false)
CONTENT_ENGINE_ENABLED=true
# SAFETY: keep true until 20–30 items per type/language have been reviewed
CONTENT_ENGINE_APPROVAL_REQUIRED=true
# Only honored when approvalRequired=false
CONTENT_ENGINE_AUTO_PUBLISH=false

# Local Ollama (generation) — no external content APIs
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_MS=180000

# Publishing limits per rolling 24h
CE_MAX_ARTICLES_PER_DAY=6
CE_MAX_POSTS_PER_DAY=8
CE_MAX_NOVELS_PER_DAY=2
CE_MAX_TOTAL_PER_DAY=12

# Queue / scheduler (serialized on low-RAM hosts)
CE_MAX_CONCURRENT=1
CE_TICK_MS=60000
CE_MAX_RETRIES=3

# Images — disabled until a licensed source is configured
CE_IMAGES_ENABLED=false
CE_IMAGES_WIKIMEDIA=true
